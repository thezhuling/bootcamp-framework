# cp .env.example .env  — docker compose and init-nacos.sh both read .env (git-ignored).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_NACOS_PASSWORD=change-me
# Base64 of >= 32 bytes: openssl rand -base64 48. Nacos refuses to start without it.
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me
# Console/admin user the init script creates; application.yml logs in with the same pair (nacos/nacos).
NACOS_ADMIN_USER=nacos
NACOS_ADMIN_PASSWORD=nacos
NACOS_NAMESPACE=bootcamp-dev
NACOS_GROUP=BOOTCAMP
